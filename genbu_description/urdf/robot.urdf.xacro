<?xml version="1.0" ?>
<robot name="genbu" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:arg name="mesh_base_url" default="package://genbu_description/meshes"/>

  <xacro:include filename="$(find create_description)/urdf/create_2.urdf.xacro" />

  <xacro:include filename="$(find genbu_description)/urdf/ydlidar.urdf.xacro" />
  <xacro:ydlidar parent="base_link" xyz="0.042 -0.042 0.0720" rpy="0 0 -1.571"
    mesh_base_url="$(arg mesh_base_url)" />
</robot>
