<launch>
  <!-- Single bridge node for all Gazebo <-> ROS 2 topics.
       Using ros_gz_bridge with a YAML config so all bridges start atomically
       with use_sim_time=true, preventing TF_OLD_DATA warnings at startup. -->
  <node pkg="ros_gz_bridge" exec="parameter_bridge" name="gz_bridge" output="screen">
    <param name="use_sim_time" value="true" />
    <param name="config_file"
        value="$(find-pkg-share genbu_simulator)/config/gz_bridges.yaml" />
  </node>
</launch>
