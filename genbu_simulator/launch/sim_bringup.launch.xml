<launch>
  <arg name="world" default="default" />
  <arg name="robot_name" default="genbu" />

  <!-- Force Mesa software rendering for WSL / non-NVIDIA environments -->
  <set_env name="LIBGL_ALWAYS_SOFTWARE" value="1" />
  <set_env name="GALLIUM_DRIVER" value="llvmpipe" />

  <!-- Launch Gazebo Sim -->
  <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
    <arg name="gz_args" value="-r --headless-rendering $(find-pkg-share genbu_simulator)/worlds/$(var world).sdf" />
  </include>

  <!-- Robot state publisher with sim time -->
  <include file="$(find-pkg-share genbu_description)/launch/description.launch">
    <arg name="use_sim_time" value="true" />
  </include>

  <!-- Spawn the robot entity in Gazebo -->
  <node pkg="ros_gz_sim" exec="create" name="spawn_robot" output="screen"
    args="-topic /robot_description -name $(var robot_name) -allow_renaming true" />

<!-- Gazebo <-> ROS 2 topic bridges -->
  <include file="$(find-pkg-share genbu_simulator)/launch/gz_bridges.launch.xml" />
</launch>
