<launch>
  <arg name="use_sim_time" default="false"/>
  <arg name="rviz_config" default="$(find-pkg-share genbu_viz)/rviz/genbu.rviz"/>

  <include file="$(find-pkg-share genbu_description)/launch/description.launch">
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
  </include>

  <node pkg="rviz2" exec="rviz2" name="rviz2" output="screen" args="-d $(var rviz_config)">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>
</launch>
