<launch>
  <arg name="use_sim_time" default="true" />

  <include file="$(find-pkg-share genbu_navigation)/launch/nav2_minimal.launch.py">
    <arg name="use_sim_time" value="$(var use_sim_time)" />
    <arg name="params_file" value="$(find-pkg-share genbu_navigation)/config/nav2_params.yaml" />
  </include>

  <node pkg="genbu_navigation" exec="tf_tree_diagnostics.py" name="tf_tree_diagnostics" output="screen">
    <param name="use_sim_time" value="$(var use_sim_time)" />
  </node>
</launch>
