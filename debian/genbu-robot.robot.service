[Unit]
Description=Genbu Robot Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/default/genbu-robot
ExecStart=/usr/bin/genbu-robot-start
User=robot
Group=robot
Restart=always
RestartSec=5
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
