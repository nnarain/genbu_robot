#!/usr/bin/make -f

%:
	dh $@

override_dh_install:
	install -D -m 644 debian/genbu-robot-defaults \
		debian/genbu-robot/etc/default/genbu-robot
	install -D -m 755 debian/genbu-robot-start \
		debian/genbu-robot/usr/bin/genbu-robot-start
	install -D -m 755 debian/genbu-robot-update \
		debian/genbu-robot/usr/bin/genbu-robot-update
	install -D -m 755 debian/genbu-robot-disable-swap \
		debian/genbu-robot/usr/bin/genbu-robot-disable-swap
	install -D -m 755 debian/genbu-robot-install-pixi \
		debian/genbu-robot/usr/bin/genbu-robot-install-pixi
	install -D -m 644 debian/pixi-config.toml \
		debian/genbu-robot/etc/pixi/config.toml
	install -D -m 644 debian/ros-setup.bash \
		debian/genbu-robot/etc/ros/setup.bash
	install -D -m 644 pixi.toml \
		debian/genbu-robot/etc/genbu-robot/pixi.toml
	install -D -m 644 pixi.lock \
		debian/genbu-robot/etc/genbu-robot/pixi.lock
	# Live pixi workspace (ownership set to the robot user in postinst).
	install -d debian/genbu-robot/opt/genbu-robot

override_dh_installsystemd:
	dh_installsystemd --name=robot
