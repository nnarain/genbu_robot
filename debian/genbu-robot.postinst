#!/bin/sh
set -e

case "$1" in
    configure)
        # Install the pixi binary (best-effort: needs network access to pixi.sh).
        /usr/bin/genbu-robot-install-pixi || true

        if [ -d /run/systemd/system ]; then
            systemctl enable bluetooth || true
            systemctl start bluetooth || true
            systemctl enable avahi-daemon || true
            systemctl start avahi-daemon || true
        fi
        ;;
esac

#DEBHELPER#
