#!/bin/sh
set -e

case "$1" in
    configure)
        # Create the robot system user/group (robot.service runs as it).
        if ! getent passwd robot >/dev/null; then
            useradd --system --user-group \
                --home-dir /opt/genbu-robot --no-create-home \
                --shell /usr/sbin/nologin \
                --comment "Genbu robot service" robot
        fi

        # /etc/genbu-robot holds the source of truth (conffiles);
        # /opt/genbu-robot is the robot-writable live workspace where pixi
        # materializes the environment, so no root is needed for the pixi
        # store. Seed it here; genbu-robot-start re-syncs on every start.
        mkdir -p /opt/genbu-robot
        if [ /etc/genbu-robot -ef /opt/genbu-robot ]; then
            echo "genbu-robot: /etc/genbu-robot and /opt/genbu-robot must be separate directories" >&2
            exit 1
        fi
        for f in pixi.toml pixi.lock; do
            if [ -e "/etc/genbu-robot/${f}" ]; then
                if [ -L "/opt/genbu-robot/${f}" ] || \
                    [ "/etc/genbu-robot/${f}" -ef "/opt/genbu-robot/${f}" ]; then
                    cp --remove-destination "/etc/genbu-robot/${f}" "/opt/genbu-robot/${f}"
                else
                    cp -u "/etc/genbu-robot/${f}" "/opt/genbu-robot/${f}"
                fi
            fi
        done
        chown -R robot:robot /opt/genbu-robot

        # Install the pixi binary (best-effort: needs network access to pixi.sh).
        /usr/bin/genbu-robot-install-pixi || true

        if [ -d /run/systemd/system ]; then
            systemctl enable bluetooth || true
            systemctl start bluetooth || true
            systemctl enable avahi-daemon || true
            systemctl start avahi-daemon || true
        fi
        ;;
esac

#DEBHELPER#
