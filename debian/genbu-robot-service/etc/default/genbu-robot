# Genbu robot container configuration
GENBU_IMAGE=ghcr.io/nnarain/genbu_robot:latest
GENBU_CONTAINER_NAME=genbu-robot
GENBU_DOCKER_PULL=always
GENBU_DOCKER_NETWORK=host
GENBU_DOCKER_PRIVILEGED=true
GENBU_DOCKER_DEVICE=/dev/ttyUSB0
# Optional extra argument, for example:
# GENBU_DOCKER_EXTRA_ARG=--device=/dev/ttyACM0:/dev/ttyACM0
GENBU_DOCKER_EXTRA_ARG=
