# Genbu robot pixi environment configuration
# Source of truth for pixi.toml / pixi.lock (package conffiles)
GENBU_PIXI_SRC=/etc/genbu-robot
# Live robot-owned workspace (synced from GENBU_PIXI_SRC on service start)
GENBU_PIXI_DIR=/opt/genbu-robot
# Pixi environment to run
GENBU_PIXI_ENV=robot

# Feature flags (set to 'false' to disable)
ENABLE_FOXGLOVE=true
ENABLE_MEDKIT=true
RECORD_BAG=false
