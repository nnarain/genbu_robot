<launch>
  <arg name="use_realsense" default="false"/>

  <include file="$(find-pkg-share create_bringup)/launch/create_2.launch" />
  <include file="$(find-pkg-share teleop_twist_joy)/launch/teleop-launch.py" >
    <arg name="joy_config" value="ps4" />
  </include>

  <!-- Sensors -->
  <include if="$(var use_realsense)" file="$(find-pkg-share realsense2_camera)/launch/rs_launch.py">
  </include>
  <include file="$(find-pkg-share rplidar_ros)/launch/rplidar_a1_launch.py">
    <arg name="serial_port" value="/dev/rplidar" />
    <arg name="frame_id" value="laser" />
  </include>

  <include file="$(find-pkg-share genbu_bringup)/launch/navigation.launch.xml">
    <arg name="use_sim_time" value="false" />
  </include>

  <!-- Web services -->
  <include file="$(find-pkg-share genbu_web)/launch/web.launch.xml" />
</launch>
