<launch>
  <arg name="use_realsense" default="false"/>

  <include file="$(find-pkg-share create_bringup)/launch/create_2.launch" />
  <include file="$(find-pkg-share teleop_twist_joy)/launch/teleop-launch.py" >
    <arg name="joy_config" value="ps4" />
  </include>

  <!-- Sensors -->
  <include if="$(var use_realsense)" file="$(find-pkg-share realsense2_camera)/launch/rs_launch.py">
  </include>
  <include file="$(find-pkg-share ydlidar_ros2_driver)/launch/ydlidar_launch.py">
    <arg name="params_file" value="$(find-pkg-share genbu_bringup)/config/ydlidar.yaml" />
  </include>
</launch>
